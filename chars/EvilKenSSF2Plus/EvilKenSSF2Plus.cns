; Evil Ken SSF2 Plus's constants and state file.

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 18
airjuggle = 200
volume = 255
sparkno = 2
guard.sparkno = 40
KO.echo = 0
;***************************************************************************
; CNS
;***************************************************************************

;[Data]
;
IntPersistIndex = 59 	;Set this to at most the index of your primary AI variable.

; Also, if your character overrides StateDef 5900, do make sure you clear
; at least var(58) there when !RoundsExisted.

FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 19
ground.front = 19
air.back = 18
air.front = 18
height = 65
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 12, -98
mid.pos = 12, -78
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.6
walk.back = -2
run.fwd  = 4.6, 0
run.back = -4.6, 0
jump.neu = 0,-9.2
jump.back = -3.4
jump.fwd = 3.4
runjump.back = -4,-8.5
runjump.fwd = 4,-8.5

[Movement]
yaccel = .50
stand.friction = .85
crouch.friction = .82

[Quotes]
victory1 = "More... OOOH! I..I Seek...More powerfull opponents...OOOH-AAH!"

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
;---------------SENTI------------------------------------------------------
[Statedef 21]
type    = S
physics = S
sprpriority = 0
anim = 20
ctrl = 0


[State 21, 1]
type = Turn
trigger1 = P2dist X < 0

[State 21, 1]
type = VelSet
trigger1=1
x = const(velocity.walk.fwd.x)


[State 21, end]
type = changestate
trigger1 = roundstate != 2
trigger2 = p2bodydist X <= 100
trigger3 = inguarddist
value = 0
ctrl = 1

[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 0]
type = ChangeState
value = 0
ctrl = 1
triggerall = var(59) > 0
trigger1 = p2statetype = A
trigger1 = p2movetype != H

[State 40, 0]
type = ChangeState
value = 1601
ctrl = 0
triggerall = var(59) > 0
triggerall = enemynear, numproj + enemy, numproj >0 || enemynear, hitdefattr = C, AP, AT, AA
trigger1 = p2bodydist X = [100, 150]

[State 40, 0]
type = ChangeState
value = 1602
ctrl = 0
triggerall = var(59) > 0
triggerall = enemynear, numproj + enemy, numproj >0 || enemynear, hitdefattr = C, AP, AT, AA
trigger1 = p2bodydist X = [180, 230]

[State 40, 0]
type = ChangeState
value = 1600
ctrl = 0
triggerall = var(59) > 0
triggerall = enemynear, numproj + enemy, numproj >0
trigger1 = p2bodydist X = [30, 70]

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[Statedef 41]
Type    = S
Physics = S
Anim = 40
Ctrl = 0
SprPriority = 0
facep2 = 1
Velset = 0,0

[State 40, 1]
Type = varSet
Trigger1 = Time = 0
Sysvar(1) = 1

[State 40, 1]
Type = varset
Trigger1 = Time = 0
var(2) = 0

[State 40, 1]
Type = varset
Trigger1 = Time = 0
var(4) = 0

[State 40, 3]
