var(2) = 1

[State 40, 4]
Type = VelSet
Trigger1 = !AnimTime
x = Const(Velocity.Runjump.Fwd.x)
y = Const(Velocity.runjump.y)

[State 260, 3]
type = Afterimage
Trigger1 = 1
Time = 8
length = 5
palbright = 0,0,0
palcontrast = 250,250,250
timegap = 2
framegap = 1
trans = none

[State 40, 6]
Type = ChangeState
Trigger1 = !AnimTime
Value = 50
Ctrl = 1

[Statedef 42]
