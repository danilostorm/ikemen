;-------------------------------------------------------------------------------
; 近距離＆遠距離立ち弱パンチ
[Statedef 200]
type    = S
movetype= A
physics = S
anim = 200
velset = 0,0
poweradd = 0
ctrl = 0
juggle  = 6

[State 200,3]
type = HitDef
trigger1 = Time = 0
attr = S, NA
damage    = Floor(49 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8)))
animtype = Light
getpower = IfElse(Var(31) = 0,21,21) * (Var(32) = 0)
givepower = IfElse(Var(31) = 0,5,5)
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = IfElse(Var(32) = 0,10,5),IfElse(Var(32) = 0,10,5)
numhits = 1
sparkno = S2100
guard.sparkno = S2200
sparkxy = -10,-73
hitsound = S200, 3
guardsound = S0, 0
ground.type = High
ground.slidetime = 6
ground.hittime  = 12
ground.velocity = -4.5
air.velocity = -3.3,0
air.cornerpush.veloff = -8.0

[State 200,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

