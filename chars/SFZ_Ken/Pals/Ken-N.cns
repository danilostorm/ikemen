;---------------------------------------------------------------------------
; 前進・後退
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && Var(31) = -1
x = const(velocity.walk.fwd.x) * 1.02

[State 20, 2]
type = VelSet
trigger1 = command = "holdback" && Var(31) = -1
x = const(velocity.walk.back.x) * 1.02

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && Var(31) = 0
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback" && Var(31) = 0
x = const(velocity.walk.back.x)

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && Var(31) = 1
x = const(velocity.walk.fwd.x) * 1.04

[State 20, 2]
type = VelSet
trigger1 = command = "holdback" && Var(31) = 1
x = const(velocity.walk.back.x) * 1.04

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

