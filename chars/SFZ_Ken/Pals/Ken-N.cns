;=====================================================================
;  CNS File For "Ken"                                   Made By M.M.R.
;                                       Ver. 1.0           2002.Oct.19
;=====================================================================

;---------------------------------------------------------------------
; 変数表
;	Var(1)	: 各種ヒット判定・演出乱数
;	Var(2)	: 地上受け身継続入力フラグ
;	Var(3)	: 挑発回数
;	Var(4)	: 掴み技回数カウンタ
;	Var(5)	: レバガチャ入力カウンタ
;	Var(6)	: レバガチャ入力カウンタ（相手側）
;	Var(22)	: 総合ヒット数
;	Var(24)	: ターゲットＩＤ
;	Var(25)	: スーパーコンボフィニッシュフラグ
;	Var(26)	: 大ジャンプフラグ
;	Var(27)	: 大ジャンプ中のレバー入力管理
;	Var(28)	: 大ジャンプフラグ２
;	Var(29)	: ＣＰＵ専用乱数
;	Var(30)	: ＣＰＵ専用フラグ
;	Var(31)	: ＩＳＭ設定
;	Var(32)	: オリジナルコンボ・強弱フラグ
;	Var(33)	: オリジナルコンボ・持続時間
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000		; 体力ゲージ上限値（デフォルト：1000）
power = 3000		; パワーゲージ上限値（デフォルト：3000）
attack = 100		; 攻撃力（％）
defence = 100		; 防御力（％）
fall.defence_up = 50	; 空中コンボ修正率（％）
liedown.time = 43	; ダウン時間（n/60秒）
airjuggle = 15		; 空中コンボ制限
sparkno = ifelse(teamside = 1,0,50000)		; 初期ヒットスパーク番号
guard.sparkno = 40	; 初期ガードスパーク番号
KO.echo = 1		; ＫＯボイスエコー（0:OFF、1:ON）
volume = 5		; キャラボイスボリューム値
IntPersistIndex = 30	; Var初期化範囲（デフォルト：60）
FloatPersistIndex = 40	; FVar初期化範囲（デフォルト：40）

[Size]
xscale = 1		; 水平サイズ倍率
yscale = 1		; 垂直サイズ倍率
ground.back = 20	; キャラ幅（地上、後ろ側）
ground.front = 20	; キャラ幅（地上、前側）
air.back = 16		; キャラ幅（空中、後ろ側）
air.front = 16		; キャラ幅（空中、前側）
z.width = 10		; キャラ幅（ｚ軸）
height = 50		; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4	; Default attack width: back, front
attack.dist = 160	; Default attack distance
proj.attack.dist = 90	; Default attack distance for projectiles
proj.doscale = 0	; Set to 1 to scale projectiles too   
head.pos = 4,-80	; 頭部座標
mid.pos = -4,-50	; 体中心部座標
shadowoffset = 1	; キャラの影・オフセット値
draw.offset = 0,0	; キャラ描画位置・オフセット値

[Velocity]
walk.fwd  = 3.00	; 前進速度
walk.back = -2.00	; 後退速度
run.fwd  = 5.50, 0	; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -4.80, 0	; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-9.2	; 垂直ジャンプ速度
jump.fwd = 3.00		; 前方ジャンプ速度
jump.back = -3.50	; 後方ジャンプ速度
;runjump.back = -2.5,-8.1 ; 後方ジャンプ速度（ダッシュ中）
;runjump.fwd = 3.6,-9.0	; 前方ジャンプ速度（ダッシュ中）
;airjump.neu = 0,-9.3	; 空中垂直ジャンプ速度
;airjump.back = -2.55,-8.1 ; 空中後方ジャンプ速度
;airjump.fwd = 2.5,-8.1	; 空中前方ジャンプ速度

[Movement]
airjump.num = 0		; 空中ジャンプ回数
;airjump.height = 35	; 空中ジャンプ最低高度
yaccel = .43		; キャラ重力加速度
stand.friction = .85	; 摩擦係数（立ち状態）
crouch.friction = .82	; 摩擦係数（しゃがみ状態）

;=====================================================================
; Definition of the Basic Action
;=====================================================================

;=====================================================================
; Definition of the Win/Lose/Intro Pause
;=====================================================================

;---------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
anim = 170
velset = 0, 0
ctrl = 0

[State 170,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,Explod]
type = Explod
trigger1 = AnimElem = 2, = 3 || AnimElem = 3, = 3
anim = 171
pos = 0, 0
postype = P1
sprpriority = -1
bindtime = -1
ownpal = 1

[State 170,PlaySnd]
type = PlaySnd
trigger1 = Time = 33
value = 4200, 1

;---------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
velset = 0, 0
ctrl = 0

[State 175,ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 170

;---------------------------------------------------------------------
; 勝利
;------------------------ スーパーコンボフィニッシュ時の保留
[Statedef 180]
type = S
movetype = I
physics = N
velset = 0, 0
ctrl = 0

[State 180,VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,2

[State 180,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,ChangeState]
type = ChangeState
trigger1 = !NumExplod(2600) && !NumExplod(2610) && !NumExplod(2620)
trigger1 = !NumExplod(2630) && !NumExplod(2640)
value = 181

;------------------------ 分岐
[Statedef 181]
type = S
movetype = I
physics = S
velset = 0, 0

[State 181,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 181,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_x"
value = 182

[State 181,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_y" || Command = "hold_b"
value = 183

[State 181,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_z" || Command = "hold_c"
value = 184

[State 181,ChangeState]
type = ChangeState
trigger1 = Time = 1
value = 182 + Var(1)

;---------------------------------------------------------------------
; 勝利１
[Statedef 182]
type = S
movetype = I
physics = S
anim = 181
velset = 0, 0
ctrl = 0

[State 182,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,260]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利２
[Statedef 183]
type = S
movetype = I
physics = S
anim = 182
velset = 0, 0
ctrl = 0

[State 182,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 8
value = 195, 0

[State 182,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,260]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利３
[Statedef 184]
type = S
movetype = I
physics = S
anim = 184
velset = 0, 0
ctrl = 0

[State 184,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 195, 0

[State 184,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,260]
flag = RoundNotOver

;---------------------------------
;vs Ryu(真空波動負け)
[Statedef 185]
type = L
movetype = I
physics = N
anim = 5110
velset = 0,0
ctrl = 0

[State 185, 1]
type = ChangeAnim
trigger1 = EnemyNear,Anim = 185 && Anim != 185
value = 185

;---------------------------------------------------------------------
; プレイントロ
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190,ChangeAnim]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190,Explod]
type = Explod
triggerall = Time = 1
trigger1 = NumPartner = 0
trigger2 = NumPartner != 0
trigger2 = !(Partner,AuthorName = "M.M.R.")
anim = 2900 + (Var(31) = 0) * 10 + (Var(31) = 1) * 20 + (Facing = -1)
pos = 50,223
postype = Back
facing = Facing
bindtime = -1
ontop = 1
ownpal = 1

[State 190,Explod]
type = Explod
trigger1 = Time = 1 && NumPartner != 0
trigger1 = Partner,AuthorName = "M.M.R."
anim = 2900 + (Var(31) = 0) * 10 + (Var(31) = 1) * 20 + (Facing = -1)
pos = 50,IfElse((Pos X - Partner,Pos X) * Facing < 0,223,207)
postype = Back
facing = Facing
bindtime = -1
ontop = 1
ownpal = 1

;2003/05/27	Adamskie Add
[State 190, vs Ryu Intro]
type = ChangeState
trigger1 = Time = 1 && Var(11) = 1
value = 193

[State 190,ChangeState]
type = ChangeState
trigger1 = Time = 1
value = 191

;---------------------------------------------------------------------
; イントロ１
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0, 0

[State 191,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 14 || AnimElem = 16
value = 200, 0

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 18
value = 200, 1

[State 191,5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;--------------------------
;イントロ２(vs Ryu by adamskie)
[Statedef 193]
type = S
movetype = I
physics = S
anim = 193

[State 193,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 193, Helper]
type = Helper
trigger1 = Time = 1
postype = p2
pos = 53,0
stateno = 192
helpertype = normal
keyctrl = 0
ownpal = 0

[State 193, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;ヘルパー
[Statedef 192]
type = A
movetype = I
physics = N
anim = 192
facep2 = 1

[State 192, 1]
type = PosAdd
trigger1 = AnimElem = 13
X = 88

[State 192, 2]
type = PosAdd
trigger1 = AnimElem = 14
X = 6
Y = -88

[State 192, 3]
type = PosAdd
trigger1 = AnimElem = 15
X = -29

[State 192, 4]
type = PosAdd
trigger1 = AnimElem = 16
X = -47
Y = 11

[State 192, 5]
type = PosAdd
trigger1 = AnimElem = 17
X = -41
Y = 13

[State 192, 6]
type = VelSet
trigger1 = AnimElem = 18
X = Abs(ScreenPos X - Parent,ScreenPos X) * -1 / 41
Y = -2.2

[State 192, 7]
type = VelAdd
trigger1 = Time >= 125
Y = 0.2

[State 192, DestroySelf]
type = DestroySelf
trigger1 = Time > 122 && Pos Y >= 0
trigger2 = RoundState = 2


;-------------------------------------------------------------------------------
; 挑発
[Statedef 195]
type = S
movetype = A
physics = S
anim = 195
velset = 0, 0
ctrl = 0
juggle = 0

[State 195,VarAdd]
type = VarAdd
trigger1 = Var(32) = 0 && Time = 0
v = 3
value = 1

[State 195,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 7
value = 195, 0
channel = 0

[State 195,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

