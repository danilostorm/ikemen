type = Explod
trigger1 = Stateno = 5300 && NumExplod(5300)=0
anim = F5300
ID = 5300
pos = 0,-100
postype = P1
sprpriority = 5

[State -2, RemoveMAXCounterBar]
type = RemoveExplod
trigger1 = Stateno != 5300
