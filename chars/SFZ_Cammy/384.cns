;=====================================================================
; States -2 
;=====================================================================
[Statedef -2]
;---------------------------------------------------------------------

[State -2, detect]
type = VarSet
trigger1 =StageVar(info.name) = "N-Bison Boss"
trigger1 = matchno = 10 && IsHomeTeam = 0
var(43) = 1

[State -2, 1]
type = stopSnd
trigger1 = stateno != 18800
channel = 7

;---------------------------------------------------------------------
;-----Dizzy Counter-----
[State -2, Hits]
type = VarAdd
triggerall = UniqHitCount <= 1
triggerall = GetHitVar(hitcount) <= 6
triggerall = StateNo >= 5000
trigger1 = MoveType = H
trigger1 = !HitShakeOver
trigger1 = Time = 0
ignorhitpause = 1
v = 15
value = 1

[State -2, Hit Subtract]
type = VarAdd
triggerall = MoveType != H
triggerall = Var(15) > 0
trigger1 = Time > 0
trigger1 = TimeMod = 40,0
v = 15
value = -1

[State -2, Hit Max]
type = VarSet
trigger1 = Var(15) >= 15
v = 15
value = 15

[State -2, Dizzy Reset]
type = VarSet
trigger1 = MoveType = H
trigger1 = !Alive
trigger2 = MoveType != H
trigger2 = Var(15) >= 15
trigger3 = UniqHitCount > 6
trigger4 = GetHitVar(hitcount) > 6
ignorehitpause = 1
v = 15
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = MoveType = H
trigger1 = !HitShakeOver
trigger1 = StateNo != 5400
trigger1 = StateNo != 5410
trigger2 = StateNo = 0
ignorehitpause = 1
v = 5
value = 0

[State -2, SelfState]
type = SelfState
triggerall = MoveType = H
triggerall = !HitShakeOver
trigger1 = StateNo != 5400
trigger1 = Var(15) >= 15
ignorehitpause = 1
value = 5400
ctrl = 0

[State -2, NotHitBy]
type = NotHitBy
trigger1 = MoveType = H
trigger1 = Var(5) > 0
value = SCA
time = 1

[State 1100, 1]
type = RemoveExplod
trigger1 = StateNo != 5300
ID = 911

