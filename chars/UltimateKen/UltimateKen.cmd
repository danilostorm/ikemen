;---------------------------------------
;guarding AI
[State -1, Stand guard AI]
type = ChangeState
value = 130
;triggerall = roundstate = 2
triggerall = var(59) = 1
triggerall = p2movetype = A ;<------- Trigger when opponent attacking
triggerall = p2bodydist x = [-700,700] ;<--- Trigger when the opponent is between 0 to 40 pixels away horizontaly
;triggerall = p2bodydist X >= 11
;triggerall = p2statetype != A ;<------- Trigger when the opponent is not in air
triggerall = random < 500 ;<---------- Trigger the move in 50% of the times the conditions is met
triggerall = statetype = S
triggerall = p2statetype = S || p2statetype = A
trigger1 = ctrl =1

;guarding Crouch AI
[State -1, crouch guard2 AI]
type = ChangeState
value = 131
;triggerall = roundstate = 2
triggerall = var(59) = 1
triggerall = p2movetype = A ;<------- Trigger when opponent attacking
triggerall = p2bodydist x = [-700,700] ;<--- Trigger when the opponent is between 0 to 40 pixels away horizontaly
;triggerall = p2bodydist X >= 11
;triggerall = p2statetype != A ;<------- Trigger when the opponent is not in air
triggerall = random < 500 ;<---------- Trigger the move in 50% of the times the conditions is met
triggerall = statetype != A
triggerall = p2statetype = C
trigger1 = ctrl =1

