;Run Fwd AI
[State -1, RunFwdAI]
type = ChangeState
value = 100
triggerall = var(59) = 1
triggerall = p2bodydist x > 50
triggerall = random < 20
triggerall = p2statetype != L
;trigger1 = command = "FF"
triggerall = statetype = S
triggerall = P2Life > 0
triggerall = P2StateNo != 5100
triggerall = P2StateNo != 5110
triggerall = P2StateNo != 5150
trigger1 = ctrl

