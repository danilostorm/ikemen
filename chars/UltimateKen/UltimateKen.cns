;One with the wind
[Statedef 110]
type = S
movetype = I
physics = S
velset = 0,0
anim = 110
ctrl = 0

[State 110, PowerAdd]
type = PowerAdd
trigger1 = time = 49
value = 50

[State 110, PlaySnd]
type = PlaySnd
trigger1 = animelem = 4
value = S724,0

[State 110, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

