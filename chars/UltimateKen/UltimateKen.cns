value = S21,0
;ignorehitpause =
;persistent =

[State 181, Woosh]
type = PlaySnd
trigger1 = time = 7
value = S0,5
;ignorehitpause =
;persistent =

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 120
flag = roundnotover

