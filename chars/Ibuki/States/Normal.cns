; Standing Light Punch
[Statedef 200]
type=S
movetype=A
physics=S
velset=0,0
ctrl=0
anim=Ifelse(P2bodydist x<10,205,200)
poweradd=0
sprpriority=2
facep2=1

[State 200, Swing Snd]
type=PlaySnd
trigger1= AnimElem=2
value=1,0
channel=1
[State 200, Voice]
type=PlaySnd
trigger1=AnimElem=2 && Random < 150
value=s Ifelse(var(46),1100,0),Ifelse(var(46),1100,5)
channel=0

[State 200, Hit]
type=HitDef
trigger1=!var(16) && (var(15)<1 || var(20))
trigger1=!Time && anim=205
attr=S, NA
damage=Ifelse(var(13),14,21), 0
guardflag=M
hitflag=MAF
ID=200*!var(20)
getpower=10 * !var(20), 0
givepower=30, 30
priority=4, Hit
pausetime =Ifelse(var(20), 4, 8), Ifelse(var(20), 4, 8)
guard.pausetime=Ifelse(var(20), 4, 8), Ifelse(var(20), 4, 8)
sparkNo=-1 + 0 * (var(33) := 8010)
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 60), var(36):=-75
hitsound=S2+10*var(44), 0
guardsound=s130, 0
animType=Light
ground.type=High
ground.slidetime=14 + 2 * var(9)
ground.hittime =14 + 2 * var(9)
guard.hittime=14
ground.velocity=ceil(-2.49*(Ifelse(!var(20),1,.5)))
guard.velocity=ceil(-2.49*(Ifelse(!var(20),1,.5)))
air.velocity=-4.21,-7.36
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
air.hittime=120
yaccel=.58
fall=0
fall.recover=1
fall.recoverTime=120
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48

[State 200, Hit]
type=HitDef
trigger1=!var(16) && (var(15)<1 || var(20))
trigger1=!Time && anim=200
attr=S, NA
damage=Ifelse(var(13),14,21), 0
guardflag=M
hitflag=MAF
ID=200*!var(20)
getpower=10 * !var(20), 0
givepower=30, 30
priority=4, Hit
pausetime =Ifelse(var(20), 4, 8), Ifelse(var(20), 4, 8)
guard.pausetime=Ifelse(var(20), 4, 8), Ifelse(var(20), 4, 8)
sparkNo=-1 + 0 * (var(33) := 8010)
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 60), var(36):=-72
hitsound=S2+10*var(44), 0
guardsound=s130, 0
animType=Light
ground.type=High
ground.slidetime=13 + 2 * var(9)
ground.hittime =13 + 2 * var(9)
guard.hittime=13
ground.velocity=ceil(Ifelse(var(55),-3,-4.49)*(Ifelse(!var(20),1,.5)))
guard.velocity=ceil(Ifelse(var(55),-3,-4.49)*(Ifelse(!var(20),1,.5)))
air.velocity=-4.21,-7.36
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
air.hittime=120
yaccel=.58
fall=0
fall.recover=1
fall.recoverTime=120
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48

[State 200, StateTypeSet: Idle]
