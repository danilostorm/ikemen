value=41, 0
channel=3
[State 1600, Dust]
type=helper
trigger1 = anim=1602 && animelem=4
helpertype=normal
stateno=8100
ID=8100
name="Jump Dust"
postype=p1
ownpal=1

[State 1600, FX]
type = helper
trigger1 = var(10)=0 && animelemtime(2)>=0 && animelemtime(5)<0 && (time%2) = 1 && numhelper(1620)<3
helpertype = normal
stateno = 1620
ID = 1620
name = "KasumigakeFX"
postype = p1
pos = 0,0
size.xscale = 0.4
size.yscale = 0.4
ownpal = 1

[State 1600, Snd]
type=PlaySnd
trigger1=animelem=2 && var(10)!=2 
trigger2=animelem=4 && var(10)=2 
value=s1600,0
channel=2
[State 1600, Voice]
type=PlaySnd
trigger1=!time
value=s Ifelse(var(46),188,0),var(46)
volumescale=50
channel=0

[State 1600, StateTypeSet]
type = StateTypeSet
trigger1 = var(10)=2 && animelem=4
statetype = A 

[State 1600, VelSet]
