trigger1 = animelem=4 && var(10)=2
x = 5.1
y = -8
[State 1600, Turn]
type = Turn
trigger1 = anim=1602 && animelem=5
trigger2 = animelem=4 && p2bodydist x<-20 && var(10)=1

[State 1600, Gravity]
type=Gravity
trigger1=var(10)=2 && animelemtime(9) >= 0

[State 1600, ScreenBound]
type = ScreenBound
trigger1 =  animelemtime(4)<0 && var(10)=1
value = 1
movecamera = 0,1

[State 1600, Posadd]
type = Posadd
trigger1 = animelemtime(1)=2 && var(10)!=2
x = 8+(2*var(10))

[State 1600, PlayerPush]
type = PlayerPush
trigger1 = animelemtime(4)<0 && var(10)=1
value = 0
[State 1600, width]
type = width
trigger1 = (animelemtime(1)>=0 && animelemtime(4)<0) && var(10)=1
edge = -35, -35
[State 1600, NotHitBy]
type = NotHitBy
trigger1 = (animelemtime(2)>=0 && animelemtime(4)<0) && var(10)=1
value = SCA
[State 1600, PosSet: Teleportation]
type = Posadd
