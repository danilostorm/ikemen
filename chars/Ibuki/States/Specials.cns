var(10) = Ifelse(p2bodydist x>280,1,Ifelse((p2bodydist x=[150,190]) && enemynear,movetype!=A && enemynear,ctrl!=1,0,2))
ignorehitpause=1
[State 1600, VarSet]
type = VarSet
trigger1 =!time
var(11) = 0
ignorehitpause=1
[State 1600, VarAdd]
type = VarAdd
trigger1 = animelemtime(4)>=0
var(11) = 1
ignorehitpause=1

[State 1600, Anim]
type=ChangeAnim
trigger1=!time
value=1600+var(10)

[State 1600, Trans]
type = Trans
trigger1 = animelemtime(4)<0 && var(10)=1
trans = addalpha
alpha = 256-32*time,0+32*time
[State 1600, Trans]
type = Trans
trigger1 = animelemtime(4)>=0 && var(10)=1
trans = addalpha
alpha = 0+16*var(11),256-16*var(11)

[State 1600, Dust Helper]
type=Helper
trigger1=animelem=2 && var(10)!=2
helperType=Normal
stateNo=8103
ID=8100
name="Dash Dust"
posType=P1
pos=-40,0
ownPal=1
pausemovetime=Ifelse(var(10)=1,255,0)

[State 1600, Snd]
