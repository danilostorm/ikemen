;-------------------------------------------------------------------------
;Kunai
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
velset = 0,0
ctrl = 0
poweradd = 72 * !var(20)
sprpriority = 1
facep2 = 1

[State 1000, FX]
type=Helper
trigger1 = !time
helpertype=normal
name="ShadowClone"
stateno=108
ID=108
pos=ceil(-20*const(size.xscale)),ceil(0*const(size.yscale))
postype=p1
ownpal=1

[State 1000, VarSet]
type = VarSet
trigger1 =!time
var(11) = 0
ignorehitpause=1
[State 1000, VarSet]
type = VarSet
trigger1 =!time
var(14) = 0
ignorehitpause=1
[State 1000, VarSet]
type = VarSet
trigger1 =!AILevel&&!time
var(10) = ifelse(command="x",0,ifelse(command="y",1,2))
ignorehitpause=1
[State 1000, VarSet]
type = VarSet
trigger1 =AILevel &&!time
var(10) = Ifelse((p2bodydist x = [-80,80]),0,Ifelse((p2bodydist x = [80,155]),1,2))
ignorehitpause=1
[State 1000, Anim]
type = ChangeAnim
trigger1 = !time
value = 1000+var(10)
ignorehitpause=1

[State 1000, Swing Snd]
type = PlaySnd
trigger1 = animelem=12
value = 1,2
channel=1
[State 1000, Release Snd]
type = PlaySnd
trigger1 = animelem=13
value = 1+10*var(44),8
channel=2

[State 1000, width]
type = width
trigger1 = animelemtime(12)>0 && animelemtime(14)<0
player = 35,-40
edge = 45, 0
ignorehitpause=1

[State 1000, Voice]
type=PlaySnd
trigger1 =animelem=11 && Random < 500
value=Ifelse(var(46),1000,0),Ifelse(var(46),var(46),random%2)
channel=0

[State 1000, Kunai]
type = helper
trigger1= animelem=13
helpertype = normal
stateno = 1005
ID = 1005
name = "Kunai"
postype = p1
pos = ceil(35*const(size.xscale)), ceil(-60*const(size.yscale))
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)
ownpal=1

[State 1000, StateTypeSet]
type = StateTypeSet
trigger1 =animelem = 19
movetype = I

[State 1000, End]
type = ChangeState
trigger1=!animtime
value=0
ctrl=1
