[State 1600, Ctrl]
type = CtrlSet
trigger1 = var(10)=0 && animelemtime(8) >= 0
trigger2 = var(10)=1 && animelemtime(11) >= 0
value = 1

[State 1600, End]
type=ChangeState
triggerall=AILevel && numenemy
trigger1=var(10)=0 && animelemtime(8) >= 0 && enemynear,movetype=A && (p2dist x=[-40,40])
trigger2=var(10)=1 && animelemtime(11) >= 0 && enemynear,movetype=A && (p2dist x=[-40,40])
value=200
[State 1600, End]
type=ChangeState
triggerall=AILevel && numenemy
trigger1=var(10)=0 && animelemtime(8) >= 0 && enemynear,movetype=A && (p2dist x=[40,90])
trigger2=var(10)=1 && animelemtime(11) >= 0 && enemynear,movetype=A && (p2dist x=[40,90])
