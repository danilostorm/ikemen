;---------------------------------------------------------------------------
;Ground Bounce
[Statedef 1181]
type=A
movetype=H
physics=N
velset=0,0

[State 1181, HitGround]
type=PosSet
trigger1=!time
y=0
[State 1181, Snd]
type=PlaySnd
trigger1=Time=1
value=F7, (sysvar(1) > 5) + (sysvar(1) > 14)
[State 1181, Bound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0
ignorehitpause=1

[State 1181, Anim]
type=GameMakeAnim
trigger1=Time=0
trigger1=!SysVar(0)
value=60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos=0, 0
under=sysvar(1) <= 14
[State 1181, EnvShake]
type=EnvShake
trigger1=!time
time=14
ampl=5

[State 1181, Anim]
type=ChangeAnim2
trigger1=!Time
value=1181
[State 1181, Velset]
type=VelSet
trigger1=animelemtime(2)=0
x=-2
y=-12
[State 1181, Veladd]
type=VelAdd
trigger1=animelemtime(2)>1
y=.4

[State 1181, Land]
type=SelfState
trigger1=animelemtime(2)>0
trigger1=Vel Y > 0 && Pos Y >= 0
value=5100
