;---------------------------------------------------------------------------
;Taunt Grab - Target
[Statedef 197]
type=S
movetype=H
physics=N
ctrl=0
sprpriority=1

[State 197, On Ground]
type=PosSet
trigger1=!Time
y=0

[State 197, HitFallSet]
type=HitFallSet
trigger1=1
value=0
[State 197, ChangeAnim2]
type=ChangeAnim2
Trigger1=!Time 
value=197
[State 197, Screenbound]
type=ScreenBound
Trigger1=1
value=1
movecamera=1,0
[State 197, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag =  noautoturn

[State 197, VelSet]
type = VelSet
trigger1 = animelem=2
x = 2
[State 197, VelMul]
type = VelMul
trigger1 = animelemtime(4)>1
x = 0.9

[State 197, SelfState]
type=SelfState
trigger1=!animtime
value=0
ctrl=1
;---------------------------------------------------------------
;Being Slammed
[StateDef 1045]
type = A
moveType = H
physics = N
velset = 0,0

[State 1045, PosFreeze]
type = PosFreeze
trigger1 = !hitshakeover
value = 1
ignorehitpause = 1
[State 1045, RemoveExplod]
type=RemoveExplod
trigger1= ishelper
ignorehitpause =1
[State 1045, DestroySelf]
type = DestroySelf
trigger1= ishelper
ignorehitpause =1

[State 1045, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = 5012

[State 1045, End]
type = ChangeState
trigger1 = HitShakeOver && pos y < 0 && time>1
value = 1048

[State 1045, End]
type = ChangeState
trigger1 = HitShakeOver && pos y >= 0 && time>1
value = 1046
;-----------------------------------------------------------------------
;Hitting the Ground
[StateDef 1046]
type = L
moveType = H
physics = N
velSet = 0,0

[State 1046, Change Anim]
type = ChangeAnim
triggerall = !Time
trigger1 = !SelfAnimExist(5100 + (Anim % 10))
value = 5100

[State 1046, Change Anim]
type = ChangeAnim
trigger1 = !Time
trigger1 = SelfAnimExist(5100 + (Anim % 10))
value = 5100 + (Anim % 10)

[State 1046, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 1046, EnvShake]
type = EnvShake
trigger1 = !Time
time = 14
ampl = -4

[State 1046, Hitting the Floor FX]
type = Explod
trigger1 = !Time
anim = F61
posType = P1
pos = 0, 0
sprPriority = -3

[State 1046, End]
type = ChangeState
trigger1 = !AnimTime
value = 1047
;--------------------------------------------------------------------
;Bouncing Off Ground
[StateDef 1047]
type = L
moveType = H
physics = N

[State 1047, Change Anim]
type = ChangeAnim
triggerAll = !Time
trigger1 = Anim != [5101,5109]
trigger2 = !SelfAnimExist(5160 + (Anim % 10))
value = 5160

[State 1047, Change Anim]
type = ChangeAnim
triggerAll = !Time
trigger1 = Anim = [5101,5109]
trigger1 = SelfAnimExist(5160 + (Anim % 10))
value = 5160 + (Anim % 10)

[State 1047, VelSet]
type = VelSet
trigger1 = !Time
y = -4.5

[State 1047, PosSet]
type = PosSet
trigger1 = !Time
y = 20

[State 1047, VelAdd]
type = VelAdd
trigger1 = 1
y = 0.4

[State 1047, End]
type = SelfState
trigger1 = vel y > 0
trigger1 = pos y >= 12
value = 5110
;---------------------------------------------------------------------------
; Air get-hit (knocked away)
[Statedef 1048]
type    = A
movetype= H
physics = N
ctrl = 0

[State 1048, anim]
type = ChangeAnim
trigger1 = Anim != [5000, 5199]
trigger1 = SelfAnimExist(5030)
value = 5030
[State 1048, anim]
type = ChangeAnim
trigger1 = Anim != [5000, 5199]
trigger1 = SelfAnimExist(5035)
value = 5035

[State 1048, veladd]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 1048, hitvel]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 1048, Change]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= Const(movement.air.gethit.groundlevel)
value = 1046
