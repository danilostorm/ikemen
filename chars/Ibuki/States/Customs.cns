trigger1=1
x=0.85
[State 6009, ScreenBound]
type = ScreenBound
trigger1 =!alive 
value = 0
movecamera = 0,0

[State 6009, Friction]
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0
[State 6009, NHB]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 6009, End] 
type=changeState
trigger1=time>1
value=5150 

