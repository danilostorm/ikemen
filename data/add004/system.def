;------------------
;//Demo mode definition//
;------------------
[Demo Mode]
	enabled=1
	select.enabled=0
	vsscreen.enabled=0
	title.waittime=800
	fight.endtime= 800
	fight.playbgm=1
	fight.bars.display=1
	intro.waitcycles=2
	debuginfo=1


;------------------
;//Continue screen definition//
;------------------
[Continue Screen]
	enabled=1
	pos=160,60
;; * fighter.defで定義されたフォントを使うらしい
	continue.text="countinue ?"
	yes.text="yes"
	yes.active.text="(YES)"
	no.text="no"
	no.active.text="(NO)"

	continue.font=  2,2,0
	yes.font=       2,2,0
	yes.active.font=2,2,0
	no.font=        2,2,0
	no.active.font= 2,2,0

	continue.offset=    0, 0
	yes.offset=       -36,42
	yes.active.offset=-36,42
	no.offset=         46,42
	no.active.offset=  46,42


;------------------
;//Win screen definition//
;------------------
[Win Screen]
	enabled=1
	wintext.text="Congratulations!"
	wintext.font=2,1,0
	wintext.offset=159,70
	wintext.displaytime=-1
	wintext.layerno=2
	fadein.time=32
	pose.time=100
	fadeout.time=60


;------------------
;//Victory screen definition//
;------------------
[Victory Screen]
	enabled=1
	time= 880
	fadein.time=32
	fadeout.time=32


;;---[options_default]---
;;--- (notmal MUGEN style [25x25])
;@@	p1.spr=9000,2


;;---[options_kof2000]---
;;--- (KOF2000 style)
	p1.spr=9000,2



	;;---
	p1.offset=310,40
	p1.facing=-1
	p1.scale=1,1
	p1.name.font=2,0,1
	p1.name.offset=18,56
	winquote.textwrap= w ;; word wrap
	winquote.text="わたしの勝ちだ！" ;;<- jp
	winquote.font=8,0,1, 0,0,0
	winquote.offset=20,130
	winquote.window=15,110,235,180

