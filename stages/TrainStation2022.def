;; Edited stage by Rabanazo, using Tatsu's Suzaku Temple stage as a base.

[Info]
	name="Metro City Trainfield"
	displayname="Metro City Trainfield"
	versiondate=14,04,2022
	mugenversion=2002,02,14 ;; [default]

[Camera]
	startx=0
	starty=0
	boundleft= -300
	boundright= 300
	boundhigh= -360
	boundlow=0
	verticalfollow=1
	tension=100;50
	floortension=150

	;;--- * v1.1 (zoom) *---
	;;cuthigh=30
	cutlow=10
	;;---
	overdrawhigh=5
	overdrawlow=5
	;;---
	tensionhigh=85 ;;t_hi
	tensionlow=25
	startzoom=1
	zoomout=0.85 ;;c_zo
	zoomin=1 ;;c_zi
	;;--- * v1.1 (zoom) *---

[PlayerInfo]
	p1startx=-70
	p1starty=0
	p1startz=0
	p1facing=1
	p2startx=70
	p2starty=0
	p2startz=0
	p2facing=-1
	leftbound=-1000
	rightbound=1000
	topbound=0
	botbound=0

[Scaling]
	topz=0
	botz=50
	topscale=1
	botscale=1.2

[Bound]
	screenleft=15
	screenright=15

[StageInfo]
	zoffset=215
	autoturn=1
	resetBG=0

[Shadow]
	color=0,0,0
	intensity=196
	reflect=0
	yscale=0.05
	fade.range=-100,0
[Reflection]
	intensity=0

[Music]
	bgmusic=sound/J.mp3
	bgvolume=355



;-----------------------
[BGdef]
	spr=TrainStation2022.sff
	debugbg=0


;-----------------------
;-----------------------


;---
;--- sky
[bg 0]
	type=normal
	spriteno=1,1
	start=0,60
	tile=1,0
	mask=0
	delta=    0.05,0
	zoomdelta=0


